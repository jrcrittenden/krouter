<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.kodelyth.krouter</string>
  <key>UserName</key><string>svc-krouter</string>
  <key>GroupName</key><string>SDS</string>
  <key>WorkingDirectory</key><string>/opt/services/krouter</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/opt/services/krouter/custom-server.js</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key><string>production</string>
    <key>PORT</key><string>20128</string>
    <key>HOSTNAME</key><string>127.0.0.1</string>
    <key>DATA_DIR</key><string>/opt/services/krouter/data</string>
    <key>PATH</key><string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/opt/services/krouter/logs/service.log</string>
  <key>StandardErrorPath</key><string>/opt/services/krouter/logs/service.error.log</string>
</dict>
</plist>
